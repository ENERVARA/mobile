<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Enervara</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>enervara</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Lets FCM wake the app to process silent/data pushes and refresh the
	     APNs token in the background. Push Notifications + Background Modes
	     capabilities still need enabling once in Xcode — see FIREBASE_SETUP.md.
	     "fetch" is also required for the daily location check-in's
	     BGAppRefreshTask (LocationBackgroundTask / AppDelegate.swift) to be
	     allowed to run in the background at all. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<!-- Daily location check-in's BGAppRefreshTask identifier — must match
	     kLocationTaskId in lib/core/background/location_task.dart and the
	     registerPeriodicTask call in AppDelegate.swift exactly. Required by
	     BGTaskScheduler; per Apple's own restriction, adding this key
	     disables the legacy performFetchWithCompletionHandler API (not used
	     here, so that's fine). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.enervara.enervara.locationRefresh</string>
	</array>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>
	<!-- Nova voice input — mic capture for speech-to-text. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Enervara uses your microphone so you can talk to Nova instead of typing.</string>
	<!-- Nova image attach — picking a photo from the library to send in chat. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Enervara needs access to your photos so you can share images with Nova.</string>
	<!-- Daily location check-in (LocationService) — shown on the initial
	     foreground request. The "always" companion string below is what iOS
	     shows if/when the user is offered "Change to Always Allow"; there is
	     no separate always-only key on modern iOS, this one covers both. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Enervara checks your location to detect recent travel, helping Nova give more accurate guidance for travel-related symptoms.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Enervara checks your location once a day, even when the app is closed, to detect recent travel and give more accurate health guidance. You can turn this off anytime in Settings.</string>
	<!-- Google Sign-In's redirect URI on iOS — the REVERSED_CLIENT_ID from
	     GoogleService-Info.plist, registered as a custom URL scheme. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.585113598278-origfmhbm0kqvegfmkgotmvhlsfapivn</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
